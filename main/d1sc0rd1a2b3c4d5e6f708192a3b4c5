do
    local Tabs = _G.PhiPhai and _G.PhiPhai.Tabs
    local Tab = Tabs and (Tabs.Info or Tabs.Discord)
    if not Tab then
        warn("[Discord] no Tabs — loader chưa export")
        return
    end

    local GB = Tab:AddLeftGroupbox("Discord")
    GB:AddLabel("PhiPhai v3")
    GB:AddToggle("PP_Discord_Test", {
        Text = "Visible Toggle",
        Default = false,
        Callback = function(v)
            if _G.PhiPhai.Notify then
                _G.PhiPhai.Notify("Discord", v and "ON" or "OFF", 2)
            end
        end,
    })
end
