do
    local Tabs = _G.PhiPhai and _G.PhiPhai.Tabs
    local Notify = _G.PhiPhai and _G.PhiPhai.Notify
    local Tab = Tabs and Tabs.Info   -- hoặc Farm, Combat, ...
    if not Tab then
        warn("[Module] Tabs missing")
        return
    end

    local GB = Tab:AddLeftGroupbox("Tên section")

    GB:AddToggle("Flag_Unique", {
        Text = "Tên toggle",
        Default = false,
        Callback = function(v)
            if Notify then Notify("Title", v and "ON" or "OFF", 2) end
        end,
    })

    GB:AddButton({
        Text = "Nút",
        Func = function() end,
    })
end
